# 1. 【必须忽略】含敏感信息的配置文件（数据库密码、密钥等）
/config/config_global.php
/config/config_ucenter.php

# 2. 【建议忽略】系统运行时生成的临时文件与缓存
/data/cache/
/data/threadcache/
/data/template/
/data/plugindata/
/data/log/

# 3. 【建议忽略】用户上传的附件（你已使用COS，此处为本地备份或残余）
/data/attachment/

# 4. 【建议忽略】UCenter系统缓存
/uc_server/data/
/uc_client/data/

# 5. 【可选忽略】本地开发环境与编辑器文件
.DS_Store
.idea/
.vscode/
Thumbs.db
*.log

# 6. 【可选忽略】宝塔面板相关配置
.user.ini
# install/               # 如果确认 install 目录已删除，可以取消注释这一行
